  "tools": [
    {
      "id": "python",
      "kind": "python-runtime",
      "capabilities": [
        "R4",
        "B1",
        "B2"
      ],
      "required": true,
      "recommended": true,
      "docs": "https://www.python.org/downloads/",
      "install": {
        "kind": "system",
        "auto": false,
        "argv": [],
        "shell": "安装 Python 3.8+ 并确保 python 在 PATH",
        "docs": "https://www.python.org/downloads/",
        "requires": [],
        "notes": "本 skill 的脚本都要求 Python"
      },
      "fallback": {
        "tools": [],
        "impact": "缺少 Python 时本 skill 无法运行"
      },
      "notes": "运行本脚本的解释器；版本取 sys.version"
    },
    {
      "id": "file",
      "kind": "cli",
      "capabilities": [
        "R1",
        "B1"
      ],
      "argv": [
        "file",
        "--version"
      ],
      "recommended": true,
      "docs": "https://www.darwinsys.com/file/",
      "install": {
        "kind": "apt",
        "auto": false,
        "argv": [],
        "shell": "sudo apt install file  # Debian/Ubuntu；macOS 自带",
        "docs": "https://www.darwinsys.com/file/",
        "requires": [
          "apt"
        ],
        "notes": "Windows 可用 w64devkit / Git Bash"
      },
      "fallback": {
        "tools": [
          "moria",
          "binwalk"
        ],
        "impact": "moria/binwalk 的识别结果可替代 file 的魔数判断"
      },
      "notes": "R1 首选；没有时仍可用 Python 魔数猜测"
    },
    {
      "id": "moria",
      "kind": "cli",
      "capabilities": [
        "R1",
        "R2",
        "R3",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "E6"
      ],
      "argv": [
        "moria",
        "--version"
      ],
      "alternates": [
        [
          "moria",
          "version"
        ]
      ],
      "recommended": true,
      "docs": "https://github.com/nmatt0/moria",
      "install": {
        "kind": "build-from-source",
        "auto": false,
        "argv": [],
        "shell": "git clone https://github.com/nmatt0/moria.git && cmake -S moria -B moria/build -DCMAKE_BUILD_TYPE=Release && cmake --build moria/build -j && cmake --install moria/build --prefix ~/.local",
        "docs": "https://github.com/nmatt0/moria",
        "requires": [
          "git",
          "cmake",
          "c++"
        ],
        "notes": "官方 release 也提供 .deb；先看 release assets 再决定"
      },
      "fallback": {
        "tools": [
          "binwalk",
          "unblob",
          "unsquashfs"
        ],
        "impact": "E1-E6 覆盖下降；未知块可能丢失，报告需注明降级"
      },
      "notes": "单 C++ 二进制，进程内覆盖最全；Phase 1 首选"
    },
    {
      "id": "binwalk",
      "kind": "cli",
      "capabilities": [
        "R1",
        "R2",
        "R3",
        "E1",
        "E6"
      ],
      "argv": [
        "binwalk",
        "--version"
      ],
      "recommended": true,
      "docs": "https://github.com/ReFirmLabs/binwalk",
      "install": {
        "kind": "cargo",
        "auto": true,
        "argv": [
          "cargo",
          "install",
          "binwalk",
          "--locked"
        ],
        "shell": "",
        "docs": "https://github.com/ReFirmLabs/binwalk",
        "requires": [
          "cargo"
        ],
        "notes": "binwalk v3 是 Rust 实现；旧版 Python 包不要混用"
      },
      "fallback": {
        "tools": [
          "moria",
          "unblob"
        ],
        "impact": "R2/E1 可替代，但递归覆盖较弱"
