/*
 * camera_daemon.c - synthetic hard-negative for bench sample B-009.
 *
 * The dangerous-looking calls below exist only in comments and in
 * string constants; neither system() nor strcpy() is ever invoked.
 *   strcpy(dst, src);
 *   system("/bin/sh");
 *   sprintf(cmd, "wget %s", url);
 */
