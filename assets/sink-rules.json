{
  "version": "1.2",
  "description": "IoT 固件 Layer 1 静态扫描规则库。patterns/anti 为 Python 正则（编译失败时按字面量子串处理），是初筛引擎。可选的 structural 字段为『结构级二次过滤』：仅在正则已命中的脚本/web 文件上，用 ast-grep（或 semgrep）按语法树确认调用是否真实存在，从而排除注释/字符串误报；结构否定即丢弃，引擎缺失或解析失败自动回退正则并在 engine_status.fallbacks 记录，绝不静默。仅 P0/P1 的 script/web/text 类规则配 structural；对剥离符号的 ELF 二进制不适用。category=cross-request 的规则为『跨请求污点』形态标记（读端/写端/IPC/可写路径），命中后须做写-读配对（Bridge, IEEE S&P'26），见 SKILL.md Phase 3 Track C 与 references/methodology.md §3.2。",
  "thresholds": {
    "min_string_len": 4,
    "context_lines": 2,
    "max_hits_per_rule_per_file": 1
  },
  "stdlib_whitelist": [
    "lib/libc.so", "lib/libc-", "lib/libuClibc", "lib/ld-", "lib/ld-linux",
    "lib/libcrypto.so", "lib/libssl.so", "lib/libpthread", "lib/libstdc++",
    "lib/libgcc_s", "lib/libm.so", "lib/libdl", "lib/libresolv", "lib/libnsl",
    "bin/busybox", "usr/bin/busybox", "lib/libz.so", "lib/libncurses"
  ],
  "skip_dirs": [
    "doc", "docs", "man", "info", "share/locale", "locale", "zoneinfo",
    "terminfo", "licenses", "fonts", "var/lib/dpkg", "var/lib/opkg", "var/lib/apk"
  ],
  "rules": [
    {
      "id": "P0-C-001",
      "priority": "P0",
      "category": "cmd-exec",
      "title": "C 系命令执行接口",
      "applies_to": ["binary", "text"],
      "patterns": ["\\bsystem\\s*\\(", "\\bpopen\\s*\\(", "\\bexecl[pe]?\\s*\\(", "\\bexecvp?\\s*\\(", "\\bposix_spawn\\w*\\s*\\(", "\\bvfork\\s*\\("],
      "anti": ["system\\s*\\(\\s*\"[^\"]*\"\\s*\\)"],
      "guidance": "向上追参数来源：是否来自 recv/socket/HTTP 参数，是否经过过滤，是否需认证。常量实参不报。"
    },
    {
      "id": "P0-C-002",
      "priority": "P0",
      "category": "cmd-exec",
      "title": "高危业务命令串（常被拼进 shell）",
      "applies_to": ["binary", "text", "script"],
      "patterns": ["ping\\s+-[cwn]", "\\btraceroute\\b", "\\bnslookup\\b", "\\bwget\\s", "\\bcurl\\s", "\\biptables\\b", "\\bnvram\\s+set\\b", "\\bmtd\\s+write\\b", "\\bflash_erase\\b", "\\binsmod\\b", "\\bmodprobe\\b", "\\bdd\\s+if=", "\\btar\\s+-?[xz]"],
      "anti": ["^\\s*#"],
      "guidance": "出现即优先定位调用点，看实参是否由 sprintf/strcat 拼接用户输入。"
    },
    {
      "id": "P0-S-001",
      "priority": "P0",
      "category": "cmd-exec",
      "title": "Shell 命令注入面（脚本）",
      "applies_to": ["script"],
      "patterns": ["`", "\\$\\(", "\\beval\\b", "\\bexec\\b", "\\bsource\\s+/", "\\$[A-Za-z_][A-Za-z0-9_]*\\s*\\|"],
      "anti": ["^\\s*#"],
      "structural": [
        {"engine": "ast-grep", "language": "bash",
         "pattern": ["eval $$$ARGS", "exec $$$ARGS", "source $FILE"]}
      ],
      "guidance": "重点看变量是否来自外部（nvram get、CGI 环境变量、网络请求），是否加了引号。"
    },
    {
      "id": "P0-W-001",
      "priority": "P0",
      "category": "cmd-exec",
      "title": "PHP / CGI 命令执行",
      "applies_to": ["web", "text", "script"],
      "patterns": ["\\bsystem\\s*\\(", "\\bexec\\s*\\(", "\\bshell_exec\\s*\\(", "\\bpassthru\\s*\\(", "\\bproc_open\\s*\\(", "\\bpopen\\s*\\(", "\\bassert\\s*\\(\\s*\\$", "preg_replace\\s*\\(.*/e"],
      "anti": [],
      "structural": [
        {"engine": "ast-grep", "language": "php",
         "pattern": ["system($$$ARGS)", "exec($$$ARGS)", "shell_exec($$$ARGS)", "passthru($$$ARGS)", "proc_open($$$ARGS)", "popen($$$ARGS)"]},
        {"engine": "ast-grep", "language": "python",
         "pattern": ["os.system($$$ARGS)", "os.popen($$$ARGS)", "subprocess.call($$$ARGS)", "subprocess.Popen($$$ARGS)"]},
        {"engine": "ast-grep", "language": "javascript",
         "pattern": ["child_process.exec($$$ARGS)", "child_process.execSync($$$ARGS)"]}
      ],
      "guidance": "确认参数是否直接来自 $_GET/$_POST/QUERY_STRING/CONTENT_LENGTH。"
    },
    {
      "id": "P0-J-001",
      "priority": "P0",
      "category": "web",
      "title": "前端危险 DOM 操作",
      "applies_to": ["web"],
      "patterns": ["\\beval\\s*\\(", "\\bFunction\\s*\\(", "document\\.write\\s*\\(", "\\.innerHTML\\s*=", "setTimeout\\s*\\(\\s*['\"]"],
      "anti": ["^\\s*//"],
      "structural": [
        {"engine": "ast-grep", "language": "javascript",
         "pattern": ["eval($$$ARGS)", "Function($$$ARGS)", "document.write($$$ARGS)", "$X.innerHTML = $Y", "setTimeout($$$ARGS)"]}
      ],
      "guidance": "查数据是否来自 location.hash / postMessage / 后端注入的配置。"
    },
    {
      "id": "P0-C-010",
      "priority": "P0",
      "category": "memory",
      "title": "无边界内存拷贝",
      "applies_to": ["binary", "text"],
      "patterns": ["\\bstrcpy\\s*\\(", "\\bstrcat\\s*\\(", "\\bsprintf\\s*\\(", "\\bgets\\s*\\(", "\\bsscanf\\s*\\(", "\\bmemcpy\\s*\\(", "\\bmemmove\\s*\\(", "\\balloca\\s*\\(", "\\bvsprintf\\s*\\("],
      "anti": [],
      "guidance": "必须确认目标缓冲大小与源长度是否校验；strncpy 长度取 strlen(src) 时等效无界。"
    },
    {
      "id": "P0-C-011",
      "priority": "P0",
      "category": "memory",
      "title": "格式化字符串",
      "applies_to": ["binary", "text"],
      "patterns": ["\\bprintf\\s*\\(\\s*[a-z_][A-Za-z0-9_]*\\s*\\)", "\\bfprintf\\s*\\([^,]+,\\s*[a-z_][A-Za-z0-9_]*\\s*\\)", "\\bsyslog\\s*\\([^,]+,\\s*[a-z_][A-Za-z0-9_]*\\s*\\)"],
      "anti": [],
      "guidance": "format 参数为用户可控即为漏洞；注意变参函数与被封装的情况。"
    },
    {
      "id": "P0-C-013",
      "priority": "P0",
      "category": "privileged",
      "title": "高权限 / 内核面操作",
      "applies_to": ["binary", "text", "script"],
      "patterns": ["/dev/mem", "/dev/kmem", "/proc/kcore", "\\bioctl\\s*\\(", "\\bptrace\\s*\\(", "\\binit_module\\s*\\(", "\\bdelete_module\\s*\\(", "/proc/mtd", "/dev/mtd"],
      "anti": [],
      "guidance": "查是否有权限校验与来源校验；mtd 写 + 参数可控 = 持久化能力。"
    },
    {
      "id": "P0-W-002",
      "priority": "P0",
      "category": "deserialization",
      "title": "反序列化 / 危险解析",
      "applies_to": ["binary", "text", "web", "script"],
      "patterns": ["unserialize\\s*\\(", "\\bXMLDecoder\\b", "ObjectInputStream", "yaml\\.load\\s*\\(", "pickle\\.loads?\\s*\\(", "\\bMarshal\\.load\\b"],
      "anti": [],
      "structural": [
        {"engine": "ast-grep", "language": "php", "pattern": ["unserialize($$$ARGS)"]},
        {"engine": "ast-grep", "language": "python",
         "pattern": ["yaml.load($$$ARGS)", "pickle.loads($$$ARGS)", "pickle.load($$$ARGS)"]}
      ],
      "guidance": "反序列化对象是否可被外部输入控制。"
    },
    {
      "id": "P0-B-001",
      "priority": "P0",
      "category": "cmd-exec",
      "title": "二进制中的危险命令执行符号",
      "applies_to": ["binary"],
      "patterns": ["\\bsystem\\b", "\\bpopen\\b", "\\bexecl[pe]?\\b", "\\bexecvp?\\b", "\\bposix_spawn\\w*\\b", "\\bvfork\\b"],
      "anti": [],
      "guidance": "剥离符号的 ELF 里 .dynstr 只留裸符号名，故此处不要求括号。命中只表示该符号被引用（导入或定义），必须由 Layer 3 反汇编确认调用点与参数来源，不得直接判定为 RCE。"
    },
    {
      "id": "P0-B-010",
      "priority": "P0",
      "category": "memory",
      "title": "二进制中的无边界内存操作符号",
      "applies_to": ["binary"],
      "patterns": ["\\bstrcpy\\b", "\\bstrcat\\b", "\\bsprintf\\b", "\\bgets\\b", "\\bsscanf\\b", "\\bmemcpy\\b", "\\bmemmove\\b", "\\balloca\\b", "\\bvsprintf\\b"],
      "anti": [],
      "guidance": "命中为符号级线索，需 Layer 3 定位调用点并确认长度校验缺失。"
    },
    {
      "id": "P2-B-030",
      "priority": "P2",
      "category": "crypto",
      "title": "二进制中的弱随机符号",
      "applies_to": ["binary"],
      "patterns": ["\\bsrand\\b", "\\bsrandom\\b", "\\brand\\b", "\\brandom\\b"],
      "anti": [],
      "guidance": "确认是否用于 token / 会话 / 密钥生成；注意与 ISO C 的 random() 区分。"
    },
    {
      "id": "P1-C-020",
      "priority": "P1",
      "category": "crypto",
      "title": "TLS 证书校验被关闭",
      "applies_to": ["binary", "text", "script", "config"],
      "patterns": ["SSL_VERIFY_NONE", "CURLOPT_SSL_VERIFYPEER\\s*[^\\n]*0", "CURLOPT_SSL_VERIFYHOST\\s*[^\\n]*0", "--insecure", "verify\\s*=\\s*False", "InsecureSkipVerify\\s*:\\s*true"],
      "anti": [],
      "guidance": "判断该校验关闭是否作用于与云端/OTA 服务器的连接。"
    },
    {
      "id": "P1-C-021",
      "priority": "P1",
      "category": "crypto",
      "title": "口令 / 签名比较存在时序侧信道",
      "applies_to": ["binary", "text"],
      "patterns": ["\\bstrcmp\\s*\\([^)]*(pass|passwd|token|secret|sig|hash|key)", "\\bmemcmp\\s*\\([^)]*(pass|token|sig|hash)"],
      "anti": [],
      "guidance": "确认比较对象是否为敏感值；IoT 场景通常只能作为加固项，除非可远程高频探测。"
    },
    {
      "id": "P1-C-022",
      "priority": "P1",
      "category": "crypto",
      "title": "弱摘要用于口令 / 完整性",
      "applies_to": ["binary", "text", "script"],
      "patterns": ["\\bMD5_Init\\b", "\\bMD5\\s*\\(", "\\bSHA1_Init\\b", "\\bmd5\\s*\\(", "\\bsha1\\s*\\(", "\\bcrypt\\s*\\(", "\\bdes_crypt\\b"],
      "anti": [],
      "guidance": "用于口令存储或固件完整性校验即为缺陷。"
    },
    {
      "id": "P1-C-023",
      "priority": "P1",
      "category": "crypto",
      "title": "固定 salt / IV",
      "applies_to": ["binary", "text"],
      "patterns": ["salt\\s*=\\s*\"", "iv\\s*=\\s*\"", "IV\\s*=\\s*\\{", "nonce\\s*=\\s*\""],
      "anti": [],
      "guidance": "确认是否为出厂共用常量。"
    },
    {
      "id": "P1-C-024",
      "priority": "P1",
      "category": "ota",
      "title": "固件升级 / 刷写相关函数",
      "applies_to": ["binary", "text", "script"],
      "patterns": ["check_firmware", "verify_firmware", "verify_image", "upgrade_start", "do_upgrade", "fw_update", "flash_write", "write_firmware"],
      "anti": [],
      "guidance": "定位后审计：是否有签名校验、校验失败是否继续、是否可降级、是否有路径穿越。"
    },
    {
      "id": "P1-C-025",
      "priority": "P1",
      "category": "auth",
      "title": "认证 / 鉴权相关函数（用于定位控制点）",
      "applies_to": ["binary", "text"],
      "patterns": ["(check|verify|is|do)_(auth|login|session|token|permission|admin|privilege)", "auth_required", "login_required", "session_verify", "check_passwd"],
      "anti": [],
      "guidance": "Track B 使用：这些函数定义了「应有控制」，随后核查哪些入口未调用它们。"
    },
    {
      "id": "P1-S-020",
      "priority": "P1",
      "category": "auth",
      "title": "调试 shell / 无认证 shell 入口",
      "applies_to": ["binary", "text", "script"],
      "patterns": ["telnetd\\s+-l\\s+/bin/sh", "\\btelnetd\\b", "\\butelnetd\\b", "\\bdropbear\\b", "\\bconsole\\b.*\\bshell\\b"],
      "anti": ["^\\s*#"],
      "guidance": "确认默认是否开启、是否需口令、口令是否为默认值。注意 dropbear/console 命中通常是正常服务，需结合端口与是否默认开启判定。"
    },
    {
      "id": "P1-S-021",
      "priority": "P1",
      "category": "permission",
      "title": "权限配置过宽",
      "applies_to": ["script", "text", "config"],
      "patterns": ["chmod\\s+(-R\\s+)?777", "chmod\\s+(-R\\s+)?666", "umask\\s+0"],
      "anti": ["^\\s*#"],
      "structural": [
        {"engine": "ast-grep", "language": "bash",
         "pattern": ["chmod 777 $$$REST", "chmod -R 777 $$$REST", "chmod 666 $$$REST", "chmod -R 666 $$$REST", "umask 0"]}
      ],
      "guidance": "看作用的路径是否可被低权限进程影响。"
    },
    {
      "id": "P1-G-020",
      "priority": "P1",
      "category": "config",
      "title": "SSH / 服务配置弱",
      "applies_to": ["config", "text", "script"],
      "patterns": ["PermitRootLogin\\s+yes", "PasswordAuthentication\\s+yes", "PermitEmptyPasswords\\s+yes", "StrictModes\\s+no"],
      "anti": [],
      "guidance": "结合是否 WAN 可达判定优先级。"
    },
    {
      "id": "P1-G-021",
      "priority": "P1",
      "category": "auth",
      "title": "默认口令 / 安全模式关闭",
      "applies_to": ["config", "text", "script", "binary"],
      "patterns": ["default_passwd", "default_password", "factory_passwd", "super_password", "admin_passwd", "security_mode\\s+off", "telnet_enable\\s*=\\s*1"],
      "anti": [],
      "guidance": "出厂默认开启 + WAN/LAN 可达 = P0 级别风险。"
    },
    {
      "id": "P1-W-020",
      "priority": "P1",
      "category": "attack-surface",
      "title": "Web / CGI / SOAP 入口字符串（入口枚举）",
      "applies_to": ["binary", "web", "text", "config", "script"],
      "patterns": ["/cgi-bin/", "/goform/", "/api/", "/hnap", "/soap", "SOAPAction", "/upgrade", "/backup", "/dumpcfg", "/debug", "/setup.cgi"],
      "anti": [],
      "guidance": "Layer 1 不判漏洞。产出入口清单交给 Track B 逐项核查鉴权与校验。"
    },
    {
      "id": "P1-W-021",
      "priority": "P1",
      "category": "auth",
      "title": "鉴权白名单 / 路径豁免",
      "applies_to": ["binary", "text", "config"],
      "patterns": ["(no_auth|skip_auth|auth_skip|whitelist|white_list|public_path)", "\\.(js|css|png|jpg|gif|ico)\\$"],
      "anti": [],
      "guidance": "重点看后缀匹配是否可被绕过（如 /goform/x.js、大小写、%2e）。"
    },
    {
      "id": "P2-C-030",
      "priority": "P2",
      "category": "crypto",
      "title": "弱随机数",
      "applies_to": ["binary", "text", "script"],
      "patterns": ["\\bsrand\\s*\\(\\s*time", "\\brand\\s*\\(\\s*\\)", "\\brandom\\s*\\(\\s*\\)", "\\bsrandom\\s*\\("],
      "anti": [],
      "guidance": "确认是否用于 token/会话/密钥生成。"
    },
    {
      "id": "P2-C-031",
      "priority": "P2",
      "category": "credential",
      "title": "硬编码密钥 / 口令",
      "applies_to": ["binary", "text", "script", "config"],
      "patterns": ["(KEY|SECRET|TOKEN|PASSWD|PASSWORD|APIKEY|API_KEY)\\s*[:=]\\s*\"[^\"]{4,}\""],
      "anti": ["(CHANGE_ME|changeme|xxx+|XXXX+|your_|placeholder|<[a-z_]+>|\\{\\{)"],
      "guidance": "提取后交给 mithril --secrets 做结构性与校验和判定，不要仅凭形状断言有效。"
    },
    {
      "id": "P2-C-032",
      "priority": "P2",
      "category": "debug",
      "title": "调试开关 / 测试模式",
      "applies_to": ["binary", "text", "script", "config"],
      "patterns": ["DEBUG_MODE", "ENABLE_DEBUG", "TEST_MODE", "\\bdebug\\s*[:=]\\s*1", "\\bverbose\\s*[:=]\\s*1"],
      "anti": [],
      "guidance": "确认是否在生产固件中开启。"
    },
    {
      "id": "P2-C-033",
      "priority": "P2",
      "category": "memory",
      "title": "危险 API 使用（TOCTOU / 临时文件）",
      "applies_to": ["binary", "text"],
      "patterns": ["\\btmpnam\\s*\\(", "\\bmktemp\\s*\\(", "\\baccess\\s*\\([^)]*\\)\\s*[;,]?\\s*(if|\\{)", "\\bgetenv\\s*\\(\\s*\"(LD_|PATH)"],
      "anti": [],
      "guidance": "access 后 open 的窗口是经典 TOCTOU；getenv 取 PATH 可被劫持。"
    },
    {
      "id": "P2-S-030",
      "priority": "P2",
      "category": "debug",
      "title": "监听型工具 / 无限循环",
      "applies_to": ["script", "text"],
      "patterns": ["\\bnc\\s+-l", "busybox\\s+nc", "\\bsocat\\b", "while\\s+true\\s*;?\\s*do", "while\\s+\\[\\s+1\\s+\\]"],
      "anti": ["^\\s*#"],
      "guidance": "确认是否是出厂调试服务。"
    },
    {
      "id": "P2-G-030",
      "priority": "P2",
      "category": "credential",
      "title": "配置文件明文凭据",
      "applies_to": ["config", "text"],
      "patterns": ["(password|passwd|pass|secret|token|api_key|apikey)\\s*=\\s*[^\\s#]{3,}"],
      "anti": ["(CHANGE_ME|changeme|none|null|false|0\\s*$)"],
      "guidance": "区分设备本地凭据与云侧凭据；云侧凭据优先。"
    },
    {
      "id": "P3-G-031",
      "priority": "P3",
      "category": "info",
      "title": "内网地址 / 调试地址残留",
      "applies_to": ["config", "text", "binary"],
      "patterns": ["192\\.168\\.\\d{1,3}\\.\\d{1,3}", "10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}", "127\\.0\\.0\\.1:\\d+", "\\bdebug\\.[a-z0-9\\-]+\\."],
      "anti": [],
      "guidance": "用于补全攻击面地图与云侧对接关系。"
    },
    {
      "id": "P3-G-040",
      "priority": "P3",
      "category": "info",
      "title": "版本与构建信息",
      "applies_to": ["binary", "text"],
      "patterns": ["GCC:\\s*\\(", "Buildroot", "OpenWrt", "Copyright\\s+\\(C\\)", "Linux version \\d"],
      "anti": [],
      "guidance": "用于关联组件 CVE 与编译加固选项；本身不是漏洞。"
    },
    {
      "id": "P3-G-041",
      "priority": "P3",
      "category": "info",
      "title": "注释中残留敏感内容",
      "applies_to": ["text", "script", "web", "config"],
      "patterns": ["^\\s*(#|//|<!--).*(password|token|key|secret|passwd)"],
      "anti": [],
      "guidance": "逐条确认是否为有效凭据。"
    },
    {
      "id": "P3-G-042",
      "priority": "P3",
      "category": "attack-surface",
      "title": "内嵌 URL / 云侧端点",
      "applies_to": ["binary", "text", "config", "web"],
      "patterns": ["https?://[A-Za-z0-9.\\-]{4,}"],
      "anti": [],
      "guidance": "汇总为云侧对接面清单，用于判断 mTLS/凭据共享风险。"
    },
    {
      "id": "P1-T-001",
      "priority": "P1",
      "category": "cross-request",
      "title": "NVRAM 污点读端（持久化键被读入）",
      "applies_to": ["binary", "text", "script"],
      "patterns": ["nvram_(safe_)?get\\s*\\(", "\\bnvram\\s+get\\b", "acosNvramConfig_(get|read|match|invmatch)\\s*\\("],
      "anti": [],
      "cross_request": {"store": "nvram", "role": "read", "write_api": ["nvram_set", "nvram_safe_set", "acosNvramConfig_set", "restore-config"]},
